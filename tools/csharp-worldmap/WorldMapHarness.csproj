<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LuaConsole NLua CLR 브리지 검증용. osx-arm64 네이티브 Lua를 함께 배포한다. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WzComparerR2.WzLib">
      <HintPath>$(WzLibPath)</HintPath>
    </Reference>
    <Reference Include="WzComparerR2.PluginBase">
      <HintPath>$(PluginBasePath)</HintPath>
    </Reference>
    <Reference Include="WzComparerR2.Network">
      <HintPath>$(NetworkPath)</HintPath>
    </Reference>
    <Reference Include="WzComparerR2.Common">
      <HintPath>$(CommonPath)</HintPath>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLua" Version="1.7.5" />
  </ItemGroup>
</Project>
